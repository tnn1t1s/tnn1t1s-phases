#!/usr/bin/env python3
"""Print the cable routes of a .vcv patch as readable module.port pairs.

Usage: tools/vcv-routes <patch.vcv> [more.vcv ...]

Handles both plain-JSON and zstd-tar (Rack 2) patch files. Port labels are
raw ids; pair with vcvpatch discovered metadata for names.
"""
import json
import os
import subprocess
import sys
import tempfile


def load(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (UnicodeDecodeError, json.JSONDecodeError):
        with tempfile.TemporaryDirectory() as t:
            subprocess.run(
                ["tar", "--use-compress-program=unzstd", "-xf", path, "-C", t],
                check=True, capture_output=True)
            with open(os.path.join(t, "patch.json")) as f:
                return json.load(f)


def main():
    if len(sys.argv) < 2:
        sys.exit(__doc__)
    for path in sys.argv[1:]:
        d = load(path)
        if len(sys.argv) > 2:
            print(f"== {path}")
        names = {}
        for m in d["modules"]:
            base = m["model"]
            n, i = base, 2
            while n in names.values():
                n, i = f"{base}{i}", i + 1
            names[m["id"]] = n
        for c in d["cables"]:
            print(f"{names[c['outputModuleId']]}.out{c['outputId']}"
                  f" -> {names[c['inputModuleId']]}.in{c['inputId']}")


if __name__ == "__main__":
    main()
